NAME "Giornale di esempio (inventato)"
PATH /corpora/giornale/indexed/
VERTICAL /corpora/giornale/vertical/source
ENCODING "utf-8"
LANGUAGE "Italian"
INFO "Notizie inventate per la demo; lemmi e categorie indicativi."
DEFAULTATTR word
MAXCONTEXT 80
MAXDETAIL 200

ATTRIBUTE word
ATTRIBUTE lemma
ATTRIBUTE tag
ATTRIBUTE lc {
  DYNAMIC utf8lowercase
  DYNLIB internal
  ARG1 "C"
  FUNTYPE s
  FROMATTR word
  TYPE index
  TRANSQUERY yes
}

STRUCTURE doc {
  ATTRIBUTE id
  ATTRIBUTE title
}
STRUCTURE s
