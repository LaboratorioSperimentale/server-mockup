# Copia questo file in .env e compila i valori. Il file .env non va mai committato.

DOMINIO=lab.example           # il dominio vero del laboratorio
EMAIL_ADMIN=admin@lab.example # per gli avvisi sui certificati

# Password dei database: usare valori lunghi e diversi tra loro
MYSQL_ROOT_PASSWORD=cambiami
FORGEJO_DB_PASSWORD=cambiami
INCEPTION_DB_PASSWORD=cambiami
SITO_A_DB_PASSWORD=cambiami

# Versioni delle immagini: TODO verificare quelle attuali e fissarle
FORGEJO_VERSION=11
INCEPTION_VERSION=cambiami
EXIST_VERSION=cambiami
